# Copy this file to `.env` (same folder) and edit — it's loaded automatically
# on startup (python-dotenv), no manual `export`/`setx` needed. Everything
# below has a sane default — this file is only needed to override. Nothing
# here is a secret: advanced mode runs Qwen3-VL fully locally, no API key of
# any kind is used. A variable already set in your real shell/OS environment
# always wins over whatever is in `.env`.

# Local Qwen3-VL checkpoint (downloaded once, runs fully offline after that).
# 2B fits comfortably in 8GB VRAM; step up to Qwen/Qwen3-VL-4B-Instruct if you
# have more VRAM and want better quality. Also accepts a local folder path
# (e.g. D:\models\Qwen3-VL-4B-Instruct) instead of a HuggingFace repo id —
# useful if a teammate already downloaded the weights and handed you the
# folder directly; using a local path never triggers a download.
QWEN_MODEL_ID=Qwen/Qwen3-VL-2B-Instruct
# Where the model gets downloaded to / read from. Defaults (if unset) to
# <project root>/models/huggingface — i.e. inside this app's own folder, not
# your Windows user-wide ~/.cache/huggingface — so the whole app (code +
# model) can be zipped up and moved as one self-contained folder. Only set
# this if you want to point at a different/shared cache location, e.g. one a
# teammate already populated:
# HF_HOME=D:\models\huggingface
# Fast mode's generation cap (advanced mode has its own, separate settings
# below — QWEN_ADVANCED_MAX_NEW_TOKENS / QWEN_ADVANCED_TIMEOUT). Raise this
# if FAST mode reports "Unterminated string" / truncated JSON on photos with
# several items — that means generation hit this cap before finishing.
# image_insight/vlm/json_repair.py salvages whatever complete items it can
# when that still happens, but a higher cap avoids it outright.
QWEN_MAX_NEW_TOKENS=9999
# Caps the resolution actually fed to the model (downscaled, not cropped) so
# a huge source photo can't blow past your VRAM. Lower this if you still see
# CUDA OOM errors on large photos; raise it if you have VRAM to spare and
# want the model to read finer text/details.
QWEN_MAX_IMAGE_PIXELS=1048576
QWEN_MIN_IMAGE_PIXELS=65536

# Advanced mode's OWN generation cap — independent of QWEN_MAX_NEW_TOKENS
# above. A well-formed advanced-mode item list (brand/model/color/text/
# condition per item) rarely needs more than a couple thousand tokens; kept
# well below fast mode's cap so a photo that confuses the model into
# runaway/repetitive output (repeating the same item or field over and over)
# gets cut off quickly instead of burning several minutes generating tens of
# thousands of tokens of near-duplicate text. If real advanced-mode photos
# routinely hit this cap (see the [AdvancedVision] log line's
# finish_reason=length), raise it — try 6144 next, not 9999+.
QWEN_ADVANCED_MAX_NEW_TOKENS=4096
# Hard wall-clock ceiling (seconds) on a single advanced-mode photo analysis.
# Enforced inside model.generate() itself via a stopping criteria, so it
# actually halts generation and frees the GPU when hit, not just an HTTP
# request giving up while inference keeps running. On timeout, whatever was
# generated so far is salvaged the same way a max_new_tokens cutoff is (see
# image_insight/vlm/json_repair.py); if nothing could be salvaged, the user
# sees an explicit "高级分析超时" message instead of a raw parse error.
QWEN_ADVANCED_TIMEOUT=300
# Kept equal to fast mode's own 1.15 (NOT raised) — see the long comment on
# AdvancedQwenConfig.repetition_penalty in image_insight/config.py for why.
# Short version: a text-dense product-packaging photo made the model loop
# the same few label phrases inside visible_text verbatim for 16+ minutes.
# Both transformers.no_repeat_ngram_size (hard n-gram blocking) and a raised
# repetition_penalty (1.3) were tried as fixes and BOTH reverted after
# repeatedly corrupting output into garbled/invalid Unicode on otherwise-
# clean photos (13.png/14.png) in testing — this model + greedy decoding is
# too fragile for either lever at a strength that actually suppresses the
# loop. The real fix is QWEN_ADVANCED_MAX_NEW_TOKENS (4096) + the image
# pre-downscale + the visible_text prompt cap, bounding the hang to ~166s
# worst case in testing (vs. 16+ minutes before), safely inside
# QWEN_ADVANCED_TIMEOUT's 300s backstop. Only change this value if you
# re-verify BOTH that it stops a real repeated-loop photo AND that it
# doesn't corrupt output on several ordinary photos afterward.
QWEN_ADVANCED_REPETITION_PENALTY=1.15

# Fast mode tuning (legacy RF-DETR path, not wired into the current app — see README)
RFDETR_VARIANT=medium
MIN_PHONE_CONFIDENCE=0.5

# 特别需求补充.md §1.4 "待核实" thresholds — tune once real seized-item
# photos are available. Fires when the top candidate's confidence is below
# CLASSIFICATION_LOW_CONFIDENCE_THRESHOLD, or when the top two candidates
# are within CLASSIFICATION_CLOSE_MARGIN_THRESHOLD of each other.
CLASSIFICATION_LOW_CONFIDENCE_THRESHOLD=0.35
CLASSIFICATION_CLOSE_MARGIN_THRESHOLD=0.05

# PaddleOCR cross-check for advanced mode's visible_text ("VLM 负责看懂，
# OCR 负责看清字"). Set OCR_ENABLED=false to skip loading PaddleOCR entirely
# (advanced mode still works, just without the OCR cross-check).
OCR_ENABLED=true
OCR_MIN_TEXT_CONFIDENCE=0.7

# Local SQLite file analysis results are saved to, keyed by goods_id + mode
# (re-analyzing the same item overwrites its record, see README "数据持久化").
IMAGE_INSIGHT_DB_PATH=image_insight.db
