# Everything below has a sane default — this file is only needed to override.
# Nothing here is a secret: advanced mode runs Qwen3-VL fully locally,
# no API key of any kind is used.

# Local Qwen3-VL checkpoint (downloaded once, cached under ~/.cache/huggingface,
# runs fully offline after that). 2B fits comfortably in 8GB VRAM; step up to
# Qwen/Qwen3-VL-4B-Instruct if you have more VRAM and want better quality.
QWEN_MODEL_ID=Qwen/Qwen3-VL-2B-Instruct
# Raise this if advanced mode reports "Unterminated string" / truncated JSON
# on photos with several items — that means generation hit this cap before
# finishing. image_insight/vlm/json_repair.py salvages whatever complete
# items it can when that still happens, but a higher cap avoids it outright.
QWEN_MAX_NEW_TOKENS=99999
# Caps the resolution actually fed to the model (downscaled, not cropped) so
# a huge source photo can't blow past your VRAM. Lower this if you still see
# CUDA OOM errors on large photos; raise it if you have VRAM to spare and
# want the model to read finer text/details.
QWEN_MAX_IMAGE_PIXELS=1048576
QWEN_MIN_IMAGE_PIXELS=65536

# Fast mode tuning (legacy RF-DETR path, not wired into the current app — see README)
RFDETR_VARIANT=medium
MIN_PHONE_CONFIDENCE=0.5

# 特别需求补充.md §1.4 "待核实" thresholds — tune once real seized-item
# photos are available. Fires when the top candidate's confidence is below
# CLASSIFICATION_LOW_CONFIDENCE_THRESHOLD, or when the top two candidates
# are within CLASSIFICATION_CLOSE_MARGIN_THRESHOLD of each other.
CLASSIFICATION_LOW_CONFIDENCE_THRESHOLD=0.35
CLASSIFICATION_CLOSE_MARGIN_THRESHOLD=0.05

# PaddleOCR cross-check for advanced mode's visible_text ("VLM 负责看懂，
# OCR 负责看清字"). Set OCR_ENABLED=false to skip loading PaddleOCR entirely
# (advanced mode still works, just without the OCR cross-check).
OCR_ENABLED=true
OCR_MIN_TEXT_CONFIDENCE=0.7

# Local SQLite file analysis results are saved to, keyed by goods_id + mode
# (re-analyzing the same item overwrites its record, see README "数据持久化").
IMAGE_INSIGHT_DB_PATH=image_insight.db
